<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>British vs American English</title>

<style>

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
    background: #f6f7fb;
    color: #172033;
    line-height: 1.6;
}

/* NAVIGATION */

nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;

    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(15px);

    padding: 15px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
    font-weight: 800;
    font-size: 19px;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    opacity: .85;
}

.nav-links a:hover {
    opacity: 1;
}

/* HERO */

.hero {
    min-height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    padding: 120px 20px 70px;

    background:
        radial-gradient(circle at 20% 20%, rgba(239,68,68,.35), transparent 30%),
        radial-gradient(circle at 80% 30%, rgba(59,130,246,.35), transparent 30%),
        linear-gradient(135deg,#0f172a,#172554,#1d4ed8);

    color: white;

    position: relative;
    overflow: hidden;
}

.hero-content {
    max-width: 900px;
    animation: appear 1s ease;
}

.flags {
    font-size: 75px;
    margin-bottom: 15px;
    animation: float 3s ease-in-out infinite;
}

.hero h1 {
    font-size: clamp(42px, 8vw, 75px);
    line-height: 1.05;
    margin-bottom: 25px;
    font-weight: 900;
}

.gradient-text {
    background: linear-gradient(90deg,#fff,#bfdbfe);
    -webkit-background-clip: text;
    color: transparent;
}

.hero p {
    font-size: 20px;
    max-width: 700px;
    margin: auto;
    opacity: .9;
}

.hero-button {
    display: inline-block;
    margin-top: 35px;

    padding: 15px 30px;

    background: white;
    color: #1d4ed8;

    border-radius: 50px;

    text-decoration: none;
    font-weight: 800;

    transition: .3s;
}

.hero-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,.25);
}

/* SECTIONS */

section {
    max-width: 1150px;
    margin: auto;
    padding: 90px 6%;
}

.section-title {
    text-align: center;
    font-size: 40px;
    margin-bottom: 15px;
}

.section-description {
    max-width: 700px;
    text-align: center;
    margin: 0 auto 50px;
    color: #64748b;
}

/* INTRO CARDS */

.two-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.country-card {
    padding: 35px;

    border-radius: 25px;

    background: white;

    box-shadow: 0 15px 40px rgba(15,23,42,.08);

    transition: .35s;

    position: relative;
    overflow: hidden;
}

.country-card:hover {
    transform: translateY(-8px);
}

.country-card::before {
    content: "";
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 5px;

    background: #2563eb;
}

.country-card:first-child::before {
    background: #dc2626;
}

.country-flag {
    font-size: 55px;
}

.country-card h3 {
    font-size: 28px;
    margin: 15px 0;
}

/* COMPARISON */

.comparison {
    background: white;
    border-radius: 25px;
    overflow: hidden;
    box-shadow: 0 15px 40px rgba(15,23,42,.08);
}

.table {
    width: 100%;
    border-collapse: collapse;
}

.table th {
    background: #172554;
    color: white;
    padding: 20px;
}

.table td {
    padding: 18px;
    text-align: center;
    border-bottom: 1px solid #e5e7eb;
}

.table tr:hover {
    background: #f8fafc;
}

.uk {
    color: #b91c1c;
    font-weight: 800;
}

.us {
    color: #1d4ed8;
    font-weight: 800;
}

/* SPELLING */

.spelling-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
}

.spelling {
    padding: 30px;
    border-radius: 25px;
    color: white;
}

.spelling.uk-box {
    background: linear-gradient(135deg,#991b1b,#ef4444);
}

.spelling.us-box {
    background: linear-gradient(135deg,#1e3a8a,#2563eb);
}

.word {
    display: flex;
    justify-content: space-between;

    padding: 12px 0;

    border-bottom: 1px solid rgba(255,255,255,.25);
}

/* HISTORY */

.history {
    display: grid;
    gap: 20px;
}

.history-card {
    display: flex;
    gap: 25px;
    align-items: center;

    background: white;
    padding: 25px;

    border-radius: 20px;

    box-shadow: 0 10px 30px rgba(15,23,42,.07);

    transition: .3s;
}

.history-card:hover {
    transform: translateX(7px);
}

.history-number {
    min-width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #2563eb;
    color: white;

    border-radius: 50%;

    font-weight: 900;
    font-size: 20px;
}

/* FACTS */

.fact-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
}

.fact {
    background: white;
    padding: 30px;
    border-radius: 22px;

    box-shadow: 0 10px 30px rgba(15,23,42,.07);

    transition: .3s;
}

.fact:hover {
    transform: translateY(-6px);
}

.fact-icon {
    font-size: 40px;
    margin-bottom: 15px;
}

/* PROJECT */

.project-result {
    background: linear-gradient(135deg,#172554,#2563eb);
    color: white;

    padding: 50px;
    border-radius: 30px;

    text-align: center;

    box-shadow: 0 20px 50px rgba(37,99,235,.25);
}

.project-result h2 {
    font-size: 35px;
    margin-bottom: 20px;
}

/* QUIZ */

.quiz-container {
    background: #111827;
    color: white;

    padding: 40px;

    border-radius: 30px;

    max-width: 800px;
    margin: auto;

    box-shadow: 0 20px 50px rgba(15,23,42,.2);
}

.question {
    margin-bottom: 35px;
}

.question h3 {
    margin-bottom: 15px;
}

.answer {
    width: 100%;

    padding: 15px;

    margin: 7px 0;

    border: none;
    border-radius: 12px;

    cursor: pointer;

    background: white;
    color: #172033;

    font-size: 16px;

    transition: .2s;
}

.answer:hover {
    background: #dbeafe;
    transform: translateX(4px);
}

.answer.correct {
    background: #86efac;
}

.answer.wrong {
    background: #fca5a5;
}

#quizResult {
    text-align: center;

    font-size: 23px;
    font-weight: 800;

    margin-top: 20px;
}

.restart {
    display: none;

    margin: 25px auto 0;

    padding: 12px 25px;

    border: none;
    border-radius: 50px;

    background: white;
    color: #1d4ed8;

    font-weight: 800;

    cursor: pointer;
}

/* FOOTER */

footer {
    background: #0f172a;
    color: white;

    text-align: center;

    padding: 45px 20px;
}

footer p {
    opacity: .75;
    margin-top: 7px;
}

/* ANIMATION */

@keyframes appear {
    from {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes float {
    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}

/* MOBILE */

@media(max-width:750px) {

    .nav-links {
        display: none;
    }

    nav {
        justify-content: center;
    }

    .hero {
        min-height: 90vh;
    }

    .flags {
        font-size: 55px;
    }

    .hero p {
        font-size: 17px;
    }

    section {
        padding: 65px 5%;
    }

    .section-title {
        font-size: 31px;
    }

    .two-columns,
    .spelling-grid {
        grid-template-columns: 1fr;
    }

    .fact-grid {
        grid-template-columns: 1fr;
    }

    .comparison {
        overflow-x: auto;
    }

    .table {
        min-width: 600px;
    }

    .quiz-container {
        padding: 25px 18px;
    }

}

</style>
</head>


