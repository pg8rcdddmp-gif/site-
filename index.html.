<script>

let score = 0;
let total = 0;

function answer(button, correct) {

    if (button.parentElement.dataset.done === "true") {
        return;
    }

    button.parentElement.dataset.done = "true";

    total++;

    if (correct) {

        score++;

        button.classList.add("correct");

    } else {

        button.classList.add("wrong");

    }

    document.getElementById("quizResult").innerHTML =
        "Результат: " + score + " / " + total;

    if (total === 10) {

        let percent = score * 10;

        let message = "";

        if (score >= 9) {
            message = "🏆 Отлично! Ты прекрасно различаешь варианты английского!";
        }

        else if (score >= 7) {
            message = "🌟 Очень хорошо! Ты хорошо знаешь различия.";
        }

        else if (score >= 5) {
            message = "👍 Неплохо! Но есть что повторить.";
        }

        else {
            message = "📚 Стоит ещё немного изучить British и American English.";
        }

        document.getElementById("quizResult").innerHTML =
            "Результат: " + score + " / 10<br><br>" +
            percent + "%<br>" +
            message;

        document.getElementById("restart").style.display = "block";

    }

}

</script>


